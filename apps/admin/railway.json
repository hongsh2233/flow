{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "sh -c 'python scripts/import_mujeo_bulk.py 2>/dev/null || true; uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
