# PostgreSQL (MySQL에서 전환)
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_bo
# 또는 Railway 등에서 제공하는 URL 사용:
# DATABASE_URL=postgresql://user:pass@host:5432/stock_bo

# 관리자 / 인증
ADMIN_EMAIL=admin@example.com
ADMIN_PW=your-secure-password
SECRET_TOKEN=your-session-secret
JWT_SECRET_KEY=your-jwt-secret
AUTH_COOKIE_NAME=bo_session_id

# 공공데이터포털 API (금융위/한국거래소)
DATA_GO_KR_API_KEY=your-api-key
