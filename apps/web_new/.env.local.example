# ===== Web (Next.js) 환경 변수 =====
# 이 파일을 .env.local로 복사한 후 값을 설정하세요.
# cp .env.local.example .env.local

# Admin(FastAPI) 백엔드 API 서버 URL (끝에 / 없이)
# 이메일 로그인·NextAuth credentials는 서버에서 이 URL로 /api/auth/member/login 을 호출합니다.
# 미설정 시 로그인 요청이 Next 앱 잘못된 경로로 가며 항상 실패합니다.
# 로컬: http://localhost:8080  /  프로덕션: https://(Admin 호스트)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# (선택) 서버 전용으로만 쓰려면 API_BASE_URL 동일 값 — 보통 NEXT_PUBLIC_ 만 있으면 충분

# API 인증 키 (Admin 서버의 X-API-KEY와 동일하게 설정)
NEXT_PUBLIC_X_API_KEY=your-api-key-here

# NextAuth 설정 (소셜 로그인 필수)
# openssl rand -base64 32 명령으로 생성하세요
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google 소셜 로그인 (선택)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Naver 소셜 로그인 (선택)
NAVER_CLIENT_LOGIN_ID=your-naver-client-id
NAVER_CLIENT_LOGIN_SECRET=your-naver-client-secret

# 공공데이터포털 API 키 (선택)
# https://www.data.go.kr/에서 발급받으세요
# 주의: 일반 인증키(URL Encode)가 아닌 디코딩된 인증키를 사용하세요
DATA_GO_KR_API_KEY=your_decoded_api_key_here
