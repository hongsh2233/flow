# ============================================================
# 루트 .env.local — web(Next.js) + admin(FastAPI) 공용
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
# ============================================================

# ----- DB (admin: DB_* 사용, Prisma/Web: DATABASE_URL 사용) -----
#
# [주의] DB_HOST에는 호스트명만 입력하세요! (postgresql:// URL을 넣지 마세요)
#   로컬 예시:   DB_HOST=localhost
#   Railway 예시: DB_HOST=turntable.proxy.rlwy.net
#
# [주의] DB_PORT: Railway는 5432가 아닌 별도 포트를 사용합니다 (Railway 대시보드에서 확인)
#   로컬 예시:   DB_PORT=5432
#   Railway 예시: DB_PORT=14762
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_bo
DB_USER=postgres
DB_PASSWORD=postgres_password

# DATABASE_URL: 전체 연결 URL (설정하면 위 DB_* 변수보다 우선 사용됨)
# Railway 공개 연결 시 반드시 ?sslmode=require 를 붙여야 합니다
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/stock_bo
# DATABASE_URL=postgresql://postgres:your_password@turntable.proxy.rlwy.net:14762/railway?sslmode=require

# ----- Admin 인증 -----
ADMIN_EMAIL=admin@example.com
ADMIN_PW=your-secure-password
SECRET_TOKEN=your-session-secret
JWT_SECRET_KEY=your-jwt-secret
AUTH_COOKIE_NAME=bo_session_id

# ----- 공공데이터포털 API (web + admin) -----
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# ----- Web(Next.js) ↔ Admin API 연동 -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_X_API_KEY=your-shared-api-key

# ----- NextAuth (web) -----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_LOGIN_ID=
NAVER_CLIENT_LOGIN_SECRET=

# ----- 기타 (web) -----
NAVER_CLIENT_ID=A84Urh7iuzPL517X7T50
NAVER_CLIENT_SECRET=AopZ_T1aEw
